# ==============================================================================
# Monitor App - Environment Configuration Example
# Copy to '.env' for local development or direct database connections.
# NOTE: In AWS EC2 production, prefer AWS Secrets Manager (Option A) to avoid
# storing database passwords on disk.
# ==============================================================================

# ------------------------------------------------------------------------------
# Option A: Production with AWS Secrets Manager (Zero Plaintext Secrets)
# The EC2 instance retrieves credentials automatically using its IAM role.
# ------------------------------------------------------------------------------
AWS_SECRET_NAME=prod/sysmon/rds-mysql
AWS_REGION=us-east-1

# ------------------------------------------------------------------------------
# Option B: Direct / Local Database Configuration (.env Fallback)
# Used when AWS_SECRET_NAME is not set (e.g., local Docker Compose / test database)
# ------------------------------------------------------------------------------
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_USER=sysmon_user
# DB_PASSWORD=replace_with_your_db_password
# DB_NAME=sysmon_db
# DB_SSL_CA=

# ------------------------------------------------------------------------------
# Monitor Engine Settings & Thresholds
# ------------------------------------------------------------------------------
SYSMON_INTERVAL=10
SYSMON_CPU_THRESHOLD=85.0
SYSMON_MEM_THRESHOLD=85.0
SYSMON_DISK_THRESHOLD=85.0
SYSMON_JSON=true
